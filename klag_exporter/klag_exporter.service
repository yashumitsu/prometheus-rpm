# -*- mode: conf -*-

[Unit]
Description=Kafka Lag exporter for Prometheus & opentelemetry
Documentation=https://github.com/softwaremill/klag-exporter
After=network.target

[Service]
EnvironmentFile=-/etc/default/klag_exporter
User=prometheus
ExecStart=/usr/bin/klag_exporter $KLAG_EXPORTER_OPTS
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
StartLimitInterval=0

[Install]
WantedBy=multi-user.target
